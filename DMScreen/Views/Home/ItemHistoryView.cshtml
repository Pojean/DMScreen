@model ItemLibrary

<div class="ItemLibraryFrame">
    <div class="ItemListFrame">
        @foreach(Item i in Model.itemLibrary)
        {
            
            <div class="ItemListEntity">
                <div class="ItemViewButton">
                <form asp-action="ItemView" asp-area="Home" method="post" class="ItemButton">
                    <input type="hidden" name="fName" value="@i.Name" />
                    <button type="submit">@i.Name</button>
                </form>
                </div>

                <div class="ItemEquipButton">
                    <form asp-action="AddToMyItems" asp-area="Home" method="post">
                        <input type="hidden" name="fName" value="@i.Name" />
                        <button type="submit">Add to my items</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>