<div class="LibraryBox">

	<div class="tableBox">
		<div class="tableHeadline">
			<h5>Offense</h5>
		</div>

		<div class="table">
			<table>
				<colgroup>
					<col style="width:10%" />
					<col style="width:15%" />
					<col style="width:10%" />
					<col style="width:10%" />
					<col style="width:55%" />
				</colgroup>
				<thead>
					<tr>
						<th>Name</th>
						<th>Type</th>
						<th>Tier</th>
						<th>Item Slot</th>
						<th>Description</th>
					</tr>
				</thead>
				<tbody>

					@foreach (Effect e in Model.SortedEffects[0])
					{
						<tr>
							<td>@e.Name</td>
							<td>@e.Type</td>
							<td>@e.Tier</td>
							<td>@e.ItemSlot</td>
							<td>@e.Description</td>
						</tr>
					}

				</tbody>
			</table>
		</div>
	</div>

	<div class="tableBox">
		<div class="tableHeadline">
